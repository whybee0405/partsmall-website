{
  "site": {
    "slug": "partsmall",
    "name": "Parts-Mall Africa",
    "domain": "parts-mall.co.za, www.parts-mall.co.za"
  },
  "source": "http://127.0.0.1:3051",
  "schema": "./payload-schema.json",
  "media": "media",
  "analytics": "analytics-events",
  "skip": [],
  "forms": {
    "enquiries": {
      "accept": [
        "type",
        "name",
        "company",
        "email",
        "phone",
        "region",
        "monthlySpend",
        "message",
        "branch",
        "part",
        "sourcePath"
      ],
      "rateLimit": {
        "max": 5,
        "windowMinutes": 10
      }
    }
  },
  "verify": [
    "/api/branches?where[active][equals]=true&sort=name&depth=0&limit=0",
    "/api/branches?where[slug][equals]=alberton&where[active][equals]=true&depth=1&limit=1",
    "/api/branches?where[slug][equals]=meadowdale&where[active][equals]=true&depth=1&limit=1",
    "/api/categories?sort=order&depth=1&limit=0",
    "/api/part-types?sort=label&depth=1&limit=0",
    "/api/makes?sort=order&depth=0&limit=0",
    "/api/models?sort=label&depth=1&limit=0",
    "/api/brands?sort=order&depth=1&limit=0",
    "/api/guides?sort=-publishedAt&depth=1&limit=0",
    "/api/globals/site-settings?depth=0"
  ]
}
