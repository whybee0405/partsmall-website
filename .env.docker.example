# Copy to .env before running docker compose. The CMS reads its own settings
# from cloudia/cms.env (see cloudia/cms.env.example).
NEXT_PUBLIC_SITE_URL=http://localhost:3050
HOST_PORT=3050

# CloudIA CMS image and version (see cloudia/cms-version), and where its
# backup archives go: keep that outside /var/www/html.
CLOUDIA_CMS_IMAGE=cloudia-cms
CLOUDIA_CMS_VERSION=1.7.0
CMS_BACKUP_DIR=/home/jamie/cms-backups/partsmall

# Read-only analytics share token for the blog view counts
# (CloudIA dashboard: Analytics -> Share -> new link; the token at the end of the URL).
CLOUDIA_ANALYTICS_SHARE_TOKEN=

# Runtime email configuration. Verify the sender domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@parts-mall.co.za
EMAIL_FROM_NAME=Parts-Mall Africa
ENQUIRY_TO_EMAIL=pma.sales1@parts-mall.com
