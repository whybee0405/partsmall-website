# Build context hygiene. Keeps the image small and keeps dev secrets out of it.
node_modules
.next
out
build
.audit
test-results

.git
.gitignore

# Never bake local secrets or the local database into an image.
.env
.env.local
.env*.local
partsmall.db
partsmall.db-journal

# The CMS's own config, backups and tooling; the site image does not use them.
cloudia
cms-backups
cloudia-updater
graphify-out
.codex
*.xlsx

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts
.DS_Store

Dockerfile
.dockerignore
docker-compose*.yml
