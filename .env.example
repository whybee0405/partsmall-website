# Copy to .env.local and fill in.

# CloudIA CMS that serves content, media, enquiries and analytics. Run one
# locally (docker compose up -d cms) or point at a staging install.
CLOUDIA_URL=http://127.0.0.1:8787

# Read-only analytics share token for the blog view counts (optional; the
# count is hidden when unset).
CLOUDIA_ANALYTICS_SHARE_TOKEN=

# Public site origin, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where branch and trade enquiries are delivered.
ENQUIRY_TO_EMAIL=pma.sales1@parts-mall.com

# Resend: verify the sender domain in the Resend dashboard before sending.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@parts-mall.co.za
EMAIL_FROM_NAME=Parts-Mall Africa

# Optional. The chat assistant works fully rule-based with this unset — no
# cost, no external calls. Set a real key to switch it over to a live model
# for general questions (branch lookup always stays rule-based, since that's
# a deterministic distance calculation, not something to ask a model).
# ANTHROPIC_API_KEY=
# CHAT_AI_MODEL=claude-haiku-4-5-20251001
